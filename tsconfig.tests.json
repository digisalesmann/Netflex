{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "apps/*/src/**/*.test.ts",
    "scripts/test/**/*.ts",
    "vitest.config.ts"
  ]
}

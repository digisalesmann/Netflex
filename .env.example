# NetFlex environment reference. PLACEHOLDERS ONLY — never commit real values.
# Full reference: docs/security/environment-variables.md

NETFLEX_ENV=development            # development | test | staging | production
LOG_LEVEL=info

DATABASE_URL=postgresql://netflex:netflex-dev-only@localhost:54329/netflex_dev
REDIS_URL=redis://localhost:63799

API_PORT=4000
TRUST_PROXY=false                 # must trust the web server (it proxies /api) and the load balancer in production
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VOUCHER_PEPPER=replace-with-32+-random-characters
VOUCHER_PEPPER_VERSION=1
AUTH_SECRET=replace-with-32+-random-characters

# fake = test double (development/test only; refused in staging/production)
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=               # sk_test_... outside production, sk_live_... in production
PAYSTACK_BASE_URL=https://api.paystack.co

NETWORK_ADAPTER=none               # none | fake (dev/test only) | mikrotik (not live-verified)
OTP_PROVIDER=none                  # none | fake (dev/test only)

# Keep false until docs/legal-feasibility-gates.md gates are passed.
PAID_ACCESS_ENABLED=false

# --- Web app (apps/web) ---
API_INTERNAL_URL=http://localhost:4000      # where the web server reaches the API (read at runtime)
NETFLEX_PROPERTY_SLUG=demo-lodge            # property shown on the public site
NETFLEX_COVERAGE_NOTES=                     # owner-confirmed coverage notes; leave empty if unknown
NETFLEX_LEGAL_REVIEWED=false                # set true only after legal review of the policies
NETFLEX_POLICIES_UPDATED=                   # e.g. 1 December 2026
